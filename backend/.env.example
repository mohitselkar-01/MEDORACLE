# ==============================================================
# MEDORACLE BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy to .env and fill in values for your environment.
# Never commit real secrets to Git.
# ==============================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Security Secrets
# Generate a secure random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Used by Clinical Decision Support AI)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (For CORS origin validation in production)
# Add your deployed Vercel domain (comma-separated if multiple)
FRONTEND_URL=https://medoracle.vercel.app

# ==============================================================
# DATABASE CONFIGURATION
# ==============================================================

# OPTION 1 (RECOMMENDED FOR RENDER PRODUCTION): Managed PostgreSQL
# Provide the full connection string from Render PostgreSQL, Supabase, Neon, etc.
DATABASE_URL=postgres://user:password@dpg-host-a.oregon-postgres.render.com/medoracle_db
DB_SSL=true

# OPTION 2 (LOCAL DEVELOPMENT FALLBACK): SQLite
# If DATABASE_URL is not set and DB_DIALECT is not specified, backend defaults to local SQLite.
# DB_DIALECT=sqlite
# DB_STORAGE=./database.sqlite

# OPTION 3: PostgreSQL via Individual Variables
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=medoracle
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_SSL=false
# DB_LOGGING=false
