# ==============================================================
# MEDORACLE FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy to .env or set in Vercel Project Settings > Environment Variables
# ==============================================================

# Backend API Base URL
# For local development:
VITE_API_BASE_URL=http://localhost:5000

# For production on Vercel:
# Replace with your deployed Render Web Service URL (without trailing slash)
# Example: https://medoracle-backend.onrender.com
# VITE_API_BASE_URL=https://medoracle-backend.onrender.com
